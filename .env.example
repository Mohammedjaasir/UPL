# Supabase project (Dashboard → Project Settings → API).
# The anon key is safe to expose in the browser; row-level security only allows inserts.
# Submission is disabled (with a clear message to the player) until both are set.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
